# ---- komunikaty serwera
error.login = Nieprawidłowa nazwa użytkownika lub hasło.
error.session = Zaloguj się.
error.no_target = Wybierz przynajmniej jedno miejsce zapisu: tagi, opisy zdjęć albo opis albumu.
error.no_tags = Po normalizacji nie został żaden poprawny tag.
error.no_keywords = Zaznaczono opis albumu, ale nie ma słów kluczowych.
error.no_user = Podaj przynajmniej jednego użytkownika.
error.user_not_found = Brak użytkownika Immicha „{user}”. Ta osoba musi mieć konto na tym serwerze Immich.
error.share_self = „{user}” to Twoje własne konto.
error.role = Uprawnienia muszą być jednym z: {roles}.
error.no_albums = Nie zaznaczono albumów.
warning.foreign_photos = {foreign} z {total} zdjęć należy do innych użytkowników. Immich pozwala zmieniać tagi i opisy tylko właścicielowi, więc je pominięto.
warning.album_not_owned = Album należy do {owner}; opis może zmienić tylko właściciel, więc go pominięto.
warning.verify_failed = Nie udało się sprawdzić wyniku: {error}
warning.and_more = i jeszcze {count}
warning.nothing_kept = Żadne z {total} zdjęć nie zachowało: {what} {seconds} s po zapisie. Zdjęcia są w bibliotece zewnętrznej: jeśli Immich nie może tam zapisać plików .xmp (montowanie tylko do odczytu), cofa tagi i opisy. Ustaw bibliotekę jako zapisywalną; zobacz przewodnik administratora.
warning.partly_kept = {count} z {total} zdjęć nie miało: {what} {seconds} s po zapisie: {files}. Immich może jeszcze je przetwarzać; zastosuj ponownie, aby powtórzyć tylko dla nich. Jeśli problem wraca, sprawdź, czy Immich może zapisywać pliki .xmp obok nich.
warning.llm_unavailable = Sugestie LLM są niedostępne: {error}
warning.keywords_unavailable = Formy podstawowe słów są niedostępne: {error}
what.tag = tagu „{tag}”
what.description = linii w opisie
join.and = ani

error.login_immich = Nieprawidłowy e-mail lub hasło konta Immich.
error.login_not_allowed = {user} nie ma dostępu do Album taggera. Poproś administratora o dodanie konta do auth.allowed_users.
error.login_unreachable = Nie można połączyć się z Immichem, aby sprawdzić logowanie. Spróbuj później.
login.email = E-mail konta Immich
login.hint_immich = Zaloguj się tym samym e-mailem i hasłem co w Immichu.
nav.user = Zalogowano: {user}
logs.field.by = Wykonał
error.key_create_failed = Zalogowano do Immicha, ale nie udało się utworzyć klucza API dla tej sesji. Administrator znajdzie przyczynę w logu aplikacji.
error.session_lost = Sesja wygasła (aplikacja została uruchomiona ponownie albo minął czas logowania). Zaloguj się ponownie.
login.hint_immich_keys = Zaloguj się tym samym e-mailem i hasłem co w Immichu. Pracujesz na swoich albumach i zdjęciach.
logs.person = Osoba
logs.everyone = Wszyscy
nav.albums = Albumy
nav.immich = Otwórz Immich
nav.theme = Przełącz tryb jasny / ciemny
nav.account = Konto
list.open_in_immich = Otwórz album w Immichu (nowa karta)
apply.and_remove = zdejmij {n}
apply.removed = zdjęto {tags} z: {photos}
panel.will_remove = Zostanie zdjęte ze zdjęć tego albumu (nadane wcześniej, teraz niezaznaczone): {tags}
remove.button = Usuń tagowanie
remove.confirm = Usunąć wszystko, co tagger zapisał w „{album}”?\n\nTagi zdejmowane ze zdjęć: {tags}\nRównież linia #tagów w opisach zdjęć i linia słów kluczowych w opisie albumu.\nZdjęcia należące do innego otagowanego albumu zachowają swoje tagi.
remove.working = Usuwanie tagowania: {album}…
remove.done = {album}: tagowanie usunięte. Tagi {tags} zdjęte z: {photos}; linie w opisach usunięte.
remove.failed = Nie udało się usunąć tagowania {album}: {error}
error.not_tagged = Tagger nie otagował tego albumu, nie ma czego usuwać.
warning.untag_skipped = Tag „{tag}” nie został zdjęty: nie udało się sprawdzić innych albumów, które go mają ({error}).
warning.kept_elsewhere = {count} zdjęć zachowało zdjęty tag, bo należą też do innego otagowanego albumu.
warning.not_removed = {count} zdjęć nadal miało „{tag}” {seconds} s po zdjęciu: {files}. Immich może je jeszcze przetwarzać; zastosuj ponownie, aby powtórzyć.
logs.action.remove = Usunięcie tagowania
logs.field.removed = Zdjęte tagi
app.disclaimer = Projekt niezależny, niepowiązany z Immich ani FUTO i przez nie niepromowany. Immich jest znakiem towarowym FUTO.
