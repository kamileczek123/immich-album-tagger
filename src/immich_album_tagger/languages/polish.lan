share.hint = Osoby, którym udostępnisz album, widzą zdjęcia, ich opisy i opis albumu. Tagi Immicha i rozpoznane osoby widzisz tylko Ty.
share.remove = Usuń
share.working = Udostępniam…
share.failed = Nie udostępniono: {error}
share.load_failed = Nie udało się wczytać listy osób: {error}
share.remove_failed = Nie usunięto: {error}
