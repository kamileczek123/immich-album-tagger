list.untagged = Nieotagowane
list.tagged = Otagowane
list.reload = Odśwież albumy
list.loading = Wczytywanie albumów…
list.load_failed = Nie udało się wczytać albumów: {error}
list.count = widoczne: {shown}, otagowane: {tagged} z {total}
list.no_match = Żaden album nie pasuje do filtra.
list.none = Ten klucz API nie widzi żadnych albumów. Sprawdź właściciela i uprawnienia klucza.
list.shared_by = udostępnia {owner}
list.shared_with = udostępniony z {people}
list.applied_tags = Zastosowane tagi
list.keywords = Słowa kluczowe: {keywords}
list.not_tagged = Jeszcze nieotagowany
list.untitled = (album bez tytułu)
list.ready = gotowe
list.ready_title = Sugestie przygotowane w tle
list.suggest = Zaproponuj tagi
list.share = Udostępnij album

# ---- zaznaczanie wielu albumów
bulk.start = Zaznacz albumy
bulk.done = Zakończ zaznaczanie
bulk.count = Zaznaczone: {albums}
bulk.select_all = Zaznacz wszystkie widoczne
