panel.tags = Tagi do zastosowania
panel.clear = Wyczyść
panel.tag_placeholder = Dodaj tag, np. miejsce/chorwacja
panel.tag_hint = Kliknij tag, aby go edytować. Ukośnik „/” tworzy tagi zagnieżdżone. Istniejące tagi Immicha podpowiadają się same.
panel.edit = Edytuj
panel.remove_tag = Usuń {tag}
