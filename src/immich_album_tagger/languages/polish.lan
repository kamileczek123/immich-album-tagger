target.tags_hint = Tagi Immicha na każdym Twoim zdjęciu w tym albumie. Wyszukujesz po nich tylko Ty.
target.photo = Opisy zdjęć
target.photo_hint = Dopisuje do opisu każdego zdjęcia linię typu „#miejsce/polska #sylwester”. Wyszuka ją każdy, kto widzi zdjęcia (typ wyszukiwania: Opis).
target.album = Opis albumu
target.album_hint = Dopisuje linię ze słowami kluczowymi. Znajdzie album na stronie Albumy, także osobom, którym go udostępniono.
target.photo_short = opisy zdjęć
target.album_short = opis albumu

apply.button = Zastosuj: {what}
