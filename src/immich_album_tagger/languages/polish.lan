# Immich Album Tagger - polski
# Format: klucz = tekst. {nazwa} wypełnia aplikacja. Linie zaczynające się od # to komentarze.
# Plik jest kopiowany do LANGUAGE_DIR; kopię z bieżącą @version można tam edytować.
@language = Polski
@code = pl
@version = 0.9.2

app.title = Immich Album Tagger
app.version = Wersja Immich Album Tagger

# ---- nagłówek i nawigacja
nav.logs = Logi
nav.logout = Wyloguj
nav.back = ← Wróć do albumów
status.connecting = Łączenie z Immichem…
status.connected = Immich {version}, {user}. {llm}.
status.llm_on = LLM {model}
status.llm_off = LLM wyłączony, tylko reguły
status.unreachable = Brak połączenia z Immichem: {error}
prefetch.ready = Gotowe sugestie: {ready}/{window}
prefetch.preparing = Gotowe sugestie: {ready}/{window} · przygotowuję…
prefetch.nothing = Nic do przygotowania

# ---- liczebniki (formy: one = 1, few = 2–4, many = 5+, other = ułamki)
count.albums.one = {n} album
count.albums.few = {n} albumy
count.albums.many = {n} albumów
count.albums.other = {n} albumu
count.photos.one = {n} zdjęcie
count.photos.few = {n} zdjęcia
count.photos.many = {n} zdjęć
count.photos.other = {n} zdjęcia
count.people.one = {n} osobą
count.people.few = {n} osobami
count.people.many = {n} osobami
count.people.other = {n} osobami
count.tags.one = {n} tag
count.tags.few = {n} tagi
count.tags.many = {n} tagów
count.tags.other = {n} tagu

# ---- lista albumów
