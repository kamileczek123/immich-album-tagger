# ---- login
login.title = Log in
login.username = User name
login.password = Password
login.button = Log in

# ---- messages from the server
error.login = Wrong user name or password.
error.session = Please log in.
error.no_target = Choose at least one target: tags, photo descriptions or album description.
error.no_tags = No valid tags left after normalisation.
error.no_keywords = Album description is selected but there are no keywords.
error.no_user = Enter at least one user.
error.user_not_found = No Immich user “{user}”. The person needs an account on this Immich server.
error.share_self = “{user}” is your own account.
error.role = Access must be one of: {roles}.
error.no_albums = No albums selected.
warning.foreign_photos = {foreign} of {total} photos belong to other users. Immich lets only the owner change tags and descriptions, so they are skipped.
warning.album_not_owned = The album belongs to {owner}; only the owner can change its description, so it is skipped.
warning.verify_failed = Could not verify the result: {error}
warning.and_more = and {count} more
warning.nothing_kept = None of the {total} photos kept {what} {seconds}s after applying. They are in an external library: if Immich cannot write .xmp sidecar files there (read-only mount), it removes tags and descriptions again. Make the library writable; see the admin guide.
warning.partly_kept = {count} of {total} photos did not have {what} {seconds}s after applying: {files}. Immich may still be processing them; apply again to retry only these. If they keep failing, check that Immich can write .xmp files next to them.
warning.llm_unavailable = LLM suggestions are unavailable: {error}
warning.keywords_unavailable = Base forms of words are unavailable: {error}
what.tag = tag “{tag}”
what.description = the description line
join.and = and

error.login_immich = Wrong e-mail or password of the Immich account.
error.login_not_allowed = {user} may not use the album tagger. Ask the administrator to add the account to auth.allowed_users.
error.login_unreachable = Immich cannot be reached to check the login. Try again later.
login.email = E-mail of your Immich account
login.hint_immich = Log in with the same e-mail and password as in Immich.
nav.user = Logged in: {user}
logs.field.by = By
error.key_create_failed = Logged in to Immich, but could not create an API key for this session. The administrator will find the reason in the app log.
error.session_lost = The session has ended (the app was restarted or the login expired). Please log in again.
login.hint_immich_keys = Log in with the same e-mail and password as in Immich. You work on your own albums and photos.
logs.person = Person
logs.everyone = Everyone
nav.albums = Albums
nav.immich = Open Immich
nav.theme = Switch light / dark mode
nav.account = Account
list.open_in_immich = Open the album in Immich (new tab)
apply.and_remove = remove {n}
apply.removed = removed {tags} from {photos}
panel.will_remove = Will be taken off this album's photos (applied earlier, not selected now): {tags}
remove.button = Remove tagging
remove.confirm = Remove everything the tagger wrote to “{album}”?\n\nTags taken off its photos: {tags}\nAlso the #tag line in photo descriptions and the keyword line in the album description.\nPhotos another tagged album holds keep their tags.
remove.working = Removing tagging of {album}…
remove.done = {album}: tagging removed. Tags {tags} taken off {photos}; description lines removed.
remove.failed = Removing tagging of {album} failed: {error}
error.not_tagged = The tagger has not tagged this album; there is nothing to remove.
warning.untag_skipped = Tag “{tag}” was not taken off: the other albums holding it could not be checked ({error}).
warning.kept_elsewhere = {count} photos kept a removed tag because another tagged album holds them.
warning.not_removed = {count} photos still had “{tag}” {seconds}s after taking it off: {files}. Immich may still be processing them; apply again to retry.
logs.action.remove = Remove tagging
logs.field.removed = Tags taken off
app.disclaimer = Not affiliated with or endorsed by Immich or FUTO. Immich is a trademark of FUTO.
