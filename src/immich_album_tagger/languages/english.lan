# Immich Album Tagger - English
# Format: key = text. {name} is filled in by the app. Lines starting with # are comments.
# This file is copied to LANGUAGE_DIR; a copy with the current @version may be edited there.
@language = English
@code = en
@version = 0.9.1

app.title = Immich Album Tagger
app.version = Immich Album Tagger version

# ---- header and navigation
nav.logs = Logs
nav.logout = Log out
nav.back = ← Back to albums
status.connecting = Connecting to Immich…
status.connected = Immich {version}, {user}. {llm}.
status.llm_on = LLM {model}
status.llm_off = LLM off, rules only
status.unreachable = Cannot reach Immich: {error}
prefetch.ready = Suggestions ready: {ready}/{window}
prefetch.preparing = Suggestions ready: {ready}/{window} · preparing…
prefetch.nothing = Nothing to prepare

# ---- counts (plural forms: one, other)
count.albums.one = {n} album
count.albums.other = {n} albums
count.photos.one = {n} photo
count.photos.other = {n} photos
count.people.one = {n} person
count.people.other = {n} people
count.tags.one = {n} tag
count.tags.other = {n} tags

