list.no_match = No album matches this filter.
list.none = This API key sees no albums. Check the key's owner and permissions.
list.shared_by = shared by {owner}
list.shared_with = shared with {people}
list.applied_tags = Applied tags
list.keywords = Keywords: {keywords}
list.not_tagged = Not tagged yet
list.untitled = (untitled album)
