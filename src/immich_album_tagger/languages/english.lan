panel.tag_hint = Click a tag to edit it. Use “/” for nested tags. Existing Immich tags autocomplete.
panel.edit = Edit
panel.remove_tag = Remove {tag}
panel.no_tags = No tags yet.
panel.photo_preview = Photo description line: {line}
panel.keywords = Album keywords
panel.keywords_reset = Fill from tags
panel.keywords_hint = Words people type to find this album on the Albums page, separated by spaces. Filled from the tags above and the base forms of the title words; edit freely.
panel.keywords_placeholder = e.g. sylwester zielona nowy rok
panel.keywords_suggestions = Click a suggestion to add or remove it:
panel.keywords_none = Suggestions appear with the tag suggestions.
panel.album_preview = Album description line: {line}

source.album-name = Album name
