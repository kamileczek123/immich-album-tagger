# Copy to .env and fill in. Never commit .env.

# --- Immich
IMMICH_URL=http://immich_server:2283
IMMICH_API_KEY=

# --- LLM (any OpenAI-compatible endpoint, URL including /v1)
LLM_ENABLED=true
LLM_BASE_URL=https://your.openai-compatible.url/v1
LLM_API_KEY=
LLM_MODEL=aux/qwen35-4b-mtp

# --- Web app (see config/app.yaml.example)
# Language of the UI: english, polish, or your own .lan file name.
APP_LANGUAGE=english

# --- Web UI
# Login: prefer config/credentials.yaml (hashed on first start, see its .example).
# These two are used as a plain login only when there is no credentials.yaml.
# Strongly recommended if the port is reachable by others: anyone who can open the UI can
# tag and share your whole library.
APP_USERNAME=
APP_PASSWORD=
LOG_LEVEL=INFO
