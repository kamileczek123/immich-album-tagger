# credentials.yaml - login for the web UI (optional file).
# Without this file the UI needs no login (protect it with a reverse proxy instead).
#
# Write plain values with encrypted: false. On the next start the app replaces both with
# one-way scrypt hashes and sets encrypted: true; the plain values are not kept anywhere.
# To change the login later, write plain values again and set encrypted: false.
# The config directory must be writable for this (mount it without :ro).

# false = the values below are plain text and will be hashed on start.
# true  = the values are hashes written by the app; do not edit them by hand.
# Default: false
encrypted: false

# User name for the login page. Required.
username: admin

# Password for the login page. Required. Use a long passphrase.
password: change-me
