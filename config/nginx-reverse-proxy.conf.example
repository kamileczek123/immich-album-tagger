# nginx reverse proxy for Immich Album Tagger - example, adapt names, addresses, certificates.
# See docs/ADMIN_GUIDE.md, section 3a.
#
# The app uses relative URLs only, so the SAME app, with no setting changed, works in both
# layouts below (and directly on its port for tests). Pick one, or use both at once.
#
#   192.0.2.10:8081   host and port where the immich-album-tagger container is published
#   192.0.2.10:2283   Immich (layout B only)
#
# Behind HTTPS set in app.yaml:   auth: { secure_cookie: true }
# "http2 on;" needs nginx 1.25.1+; on older nginx write "listen 443 ssl http2;" instead.
# Apply waits a few seconds for Immich's verification; large albums take longer, hence the
# generous proxy_read_timeout.


# ------------------------------------------------------------------------------------------
# Layout A: own host name, https://tagger.example.com/
# ------------------------------------------------------------------------------------------

server {
    listen 80;
    server_name tagger.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name tagger.example.com;

    ssl_certificate     /etc/ssl/example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/example.com/privkey.pem;

    location / {
        proxy_pass http://192.0.2.10:8081;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }
}


# ------------------------------------------------------------------------------------------
# Layout B: under a path of Immich's host name, https://immich.example.com/IAT/
# Add the two /IAT locations to the server block that already serves Immich, BEFORE
# "location /". Any path works (/tagger/, ...); keep the trailing slashes as shown:
# proxy_pass ".../" strips the /IAT prefix before the request reaches the app.
# On Immich's host name the app also shares Immich's light / dark setting and shows an
# "Open Immich" link in its sidebar.
# ------------------------------------------------------------------------------------------

server {
    listen 443 ssl;
    http2 on;
    server_name immich.example.com;

    ssl_certificate     /etc/ssl/example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/example.com/privkey.pem;

    client_max_body_size 0;    # Immich uploads

    # --- Immich Album Tagger -----------------------------------------------------------
    location = /IAT {
        return 301 /IAT/;
    }
    location /IAT/ {
        proxy_pass http://192.0.2.10:8081/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }
    # -----------------------------------------------------------------------------------

    # Immich itself (as in Immich's own documentation)
    location / {
        proxy_pass http://192.0.2.10:2283;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
